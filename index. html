
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Burntangle | Secure Storage</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #071629;
    color: white;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 400px;
    background: #10243d;
    padding: 35px 25px;
    border-radius: 16px;
    border: 1px solid #263e59;
}

.logo {
    text-align: center;
    margin-bottom: 30px;
}

.logo h1 {
    color: #ffffff;
    font-size: 30px;
    letter-spacing: 1px;
}

.logo p {
    color: #9aafc6;
    margin-top: 8px;
    font-size: 13px;
}

h2 {
    margin-bottom: 10px;
    font-size: 23px;
}

.subtitle {
    color: #a8b8ca;
    font-size: 14px;
    margin-bottom: 25px;
}

label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 14px;
    margin-bottom: 20px;
    border-radius: 8px;
    border: 1px solid #344d69;
    background: #071629;
    color: white;
    outline: none;
}

input:focus {
    border-color: #4b9bff;
}

button {
    width: 100%;
    padding: 14px;
    background: #2878d0;
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #1c65b5;
}

.footer {
    text-align: center;
    margin-top: 25px;
    color: #8297ae;
    font-size: 12px;
}
</style>
</head>

<body>

<div class="container">

    <div class="logo">
        <h1>BURNTANGLE</h1>
        <p>PRIVATE CLOUD STORAGE</p>
    </div>

    <h2>Welcome Back</h2>
    <p class="subtitle">
        Sign in to access your secure workspace.
    </p>

    <form id="loginForm">

        <label for="email">Email Address</label>
        <input
            type="email"
            id="email"
            placeholder="Enter your email"
            required
        >

        <label for="password">Password</label>
        <input
            type="password"
            id="password"
            placeholder="Enter your password"
            required
        >

        <button type="submit">Sign In</button>

    </form>

    <div class="footer">
        © 2026 Burntangle. All rights reserved.
        <br><br>
        Secure • Private • Reliable
    </div>

</div>

<script>
document.getElementById("loginForm")
.addEventListener("submit", function(event) {
    event.preventDefault();
    alert("Login system is being developed.");
});
</script>

</body>
</html>
