<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#102b50">
  <title>Burntangle | Private Storage</title>
  <style>
    :root {
      --navy: #102b50;
      --blue: #1d4778;
      --pale: #edf3fa;
      --ink: #17263a;
      --muted: #718096;
      --white: #ffffff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: linear-gradient(145deg, #eaf0f7, #ffffff 55%, #e6eef8);
      display: flex;
      flex-direction: column;
    }

    header {
      background: var(--navy);
      color: white;
      padding: 19px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-size: 23px;
      font-weight: 800;
      letter-spacing: 1.5px;
    }

    .brand span { color: #a9c9ee; }

    .tagline {
      font-size: 12px;
      color: #d5e2f1;
      margin-top: 4px;
    }

    .secure {
      font-size: 12px;
      color: #d5e2f1;
    }

    main {
      width: min(100% - 32px, 440px);
      margin: auto;
      padding: 38px 0;
    }

    .card {
      background: white;
      border: 1px solid #dce5ef;
      border-radius: 18px;
      padding: 34px 30px;
      box-shadow: 0 16px 45px rgba(16, 43, 80, .10);
    }

    .mark {
      width: 54px;
      height: 54px;
      border-radius: 15px;
      background: var(--pale);
      color: var(--navy);
      display: grid;
      place-items: center;
      font-size: 25px;
      font-weight: 800;
      margin-bottom: 22px;
    }

    h1 {
      margin: 0 0 9px;
      color: var(--navy);
      font-size: 27px;
    }

    .intro {
      color: var(--muted);
      line-height: 1.55;
      font-size: 14px;
      margin: 0 0 27px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin: 17px 0 8px;
    }

    input {
      width: 100%;
      padding: 14px 13px;
      border: 1px solid #ccd7e4;
      border-radius: 9px;
      font-size: 15px;
      outline: none;
      background: #fbfdff;
    }

    input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(29,71,120,.10);
    }

    .password-wrap {
      display: flex;
      gap: 8px;
    }

    .password-wrap input {
      flex: 1;
      min-width: 0;
    }

    .show {
      border: 1px solid #ccd7e4;
      background: #f4f7fb;
      color: var(--navy);
      border-radius: 9px;
      padding: 0 12px;
      font-weight: 700;
    }

    .primary {
      width: 100%;
      margin-top: 24px;
      padding: 15px;
      border: 0;
      border-radius: 9px;
      background: var(--navy);
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .primary:active { background: var(--blue); }

    .switch {
      text-align: center;
      font-size: 13px;
      color: var(--muted);
      margin: 21px 0 0;
    }

    .switch button {
      border: 0;
      background: none;
      color: var(--blue);
      font-weight: 700;
      cursor: pointer;
      font-size: 13px;
    }

    .notice {
      display: none;
      margin-top: 16px;
      padding: 12px;
      border-radius: 8px;
      background: #fff6df;
      color: #74520a;
      font-size: 12px;
      line-height: 1.5;
    }

    footer {
      text-align: center;
      color: #7b8999;
      font-size: 11px;
      padding: 20px;
    }

    @media (max-width: 420px) {
      .card { padding: 28px 22px; }
      .secure { display: none; }
    }
  </style>
</head>

<body>
  <header>
    <div>
      <div class="brand">BURNTANGLE<span>.</span></div>
      <div class="tagline">PRIVATE STORAGE APPLICATION</div>
    </div>
    <div class="secure">PRIVATE • SECURE • ORGANIZED</div>
  </header>

  <main>
    <section class="card">
      <div class="mark">B</div>

      <h1 id="heading">Welcome Back</h1>

      <p class="intro" id="intro">
        Sign in to access your Burntangle private storage account.
      </p>

      <form id="authForm">
        <label for="email">Email address</label>

        <input
          id="email"
          type="email"
          placeholder="Enter your email"
          autocomplete="email"
          required
        >

        <label for="password">Password</label>

        <div class="password-wrap">
          <input
            id="password"
            type="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            minlength="6"
            required
          >

          <button class="show" type="button" id="togglePassword">
            Show
          </button>
        </div>

        <button class="primary" type="submit" id="submitButton">
          Sign In
        </button>
      </form>

      <p class="switch" id="switchText">
        Don't have an account?
        <button type="button" id="switchButton">Register</button>
      </p>

      <div class="notice" id="notice">
        This is the Burntangle login-page interface.
        Authentication is not connected yet.
        Connect a secure authentication service before using real
        accounts or storing documents.
      </div>
    </section>
  </main>

  <footer>
    © 2026 Burntangle. All rights reserved.
  </footer>

  <script>
    const form = document.getElementById('authForm');
    const heading = document.getElementById('heading');
    const intro = document.getElementById('intro');
    const submitButton = document.getElementById('submitButton');
    const switchText = document.getElementById('switchText');
    const switchButton = document.getElementById('switchButton');
    const password = document.getElementById('password');
    const togglePassword = document.getElementById('togglePassword');
    const notice = document.getElementById('notice');

    let registering = false;

    togglePassword.addEventListener('click', () => {
      const hidden = password.type === 'password';
      password.type = hidden ? 'text' : 'password';
      togglePassword.textContent = hidden ? 'Hide' : 'Show';
    });

    switchButton.addEventListener('click', () => {
      registering = !registering;

      heading.textContent = registering
        ? 'Create Account'
        : 'Welcome Back';

      intro.textContent = registering
        ? 'Create your Burntangle private storage account.'
        : 'Sign in to access your Burntangle private storage account.';

      submitButton.textContent = registering
        ? 'Create Account'
        : 'Sign In';

      switchText.firstChild.textContent = registering
        ? 'Already have an account? '
        : "Don't have an account? ";

      switchButton.textContent = registering
        ? 'Sign In'
        : 'Register';

      password.autocomplete = registering
        ? 'new-password'
        : 'current-password';

      notice.style.display = 'none';
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      notice.style.display = 'block';
    });
  </script>
</body>
</html>
